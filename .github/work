name: Destroy Application

on:
  workflow_dispatch:
    inputs:
      environment:
        description: "Target environment to destroy"
        required: true
        type: choice
        options:
          - test
          - dev
          - prod
      destroy_infra:
        description: "Also destroy infrastructure (EKS, VPC)?"
        required: true
        default: false
        type: boolean

permissions:
  contents: read
  id-token: write

jobs:
  destroy-app:
    runs-on: ubuntu-latest
    environment: ${{ github.event.inputs.environment }}
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set environment config
        id: config
        shell: bash
        run: |
          ENV="${{ github.event.inputs.environment }}"
          NAMESPACE="banking-${ENV}"
          echo "namespace=$NAMESPACE" >> "$GITHUB_OUTPUT"
          echo "Destroying app in environment: $ENV (namespace: $NAMESPACE)"

      - name: Configure AWS Credentials
        uses: aws-actions/configure-aws-credentials@v4
        with:
          aws-access-key-id: ${{ secrets.AWS_ACCESS_KEY_ID }}
          aws-secret-access-key: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
          aws-region: ${{ secrets.AWS_REGION }}

      - name: Install kubectl and Helm
        shell: bash
        run: |
          curl -LO "https://dl.k8s.io/release/$(curl -sL https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl"
          chmod +x kubectl
          sudo mv kubectl /usr/local/bin/
          curl -fsSL https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash

      - name: Update kubeconfig
        shell: bash
        run: |
          aws eks update-kubeconfig \
            --name "${{ secrets.VPC_NAME }}-cluster" \
            --region "${{ secrets.AWS_REGION }}" || true

      - name: Uninstall Helm release
        shell: bash
        run: |
          NAMESPACE="${{ steps.config.outputs.namespace }}"
          helm uninstall banking-app -n "$NAMESPACE" --ignore-not-found || true
          echo "Helm release uninstalled from namespace: $NAMESPACE"

      - name: Delete namespace
        shell: bash
        run: |
          NAMESPACE="${{ steps.config.outputs.namespace }}"
          kubectl delete namespace "$NAMESPACE" --ignore-not-found || true
          echo "Namespace $NAMESPACE deleted"

  destroy-infra:
    needs: destroy-app
    if: github.event.inputs.destroy_infra == 'true'
    runs-on: ubuntu-latest
    environment: ${{ github.event.inputs.environment }}
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Configure AWS Credentials
        uses: aws-actions/configure-aws-credentials@v4
        with:
          aws-access-key-id: ${{ secrets.AWS_ACCESS_KEY_ID }}
          aws-secret-access-key: ${{ secrets.AWS_SECRET_ACCESS_KEY }}
          aws-region: ${{ secrets.AWS_REGION }}

      - name: Setup Terraform
        uses: hashicorp/setup-terraform@v3
        with:
          terraform_wrapper: false

      - name: Create terraform.tfvars
        working-directory: ./terraform
        shell: bash
        run: |
          cat > terraform.tfvars <<EOF
          region              = "${{ secrets.AWS_REGION }}"
          ami                 = "${{ secrets.AMI_ID }}"
          instance_type       = "${{ secrets.INSTANCE_TYPE }}"
          instance-name-nginx = "${{ secrets.INSTANCE_NAME_NGINX }}"
          vpc_name            = "${{ secrets.VPC_NAME }}"
          key_name            = "${{ secrets.KEY_NAME }}"
          EOF

      - name: Terraform Init
        working-directory: ./terraform
        env:
          TF_VAR_eks_admin_principal_arn: ${{ secrets.EKS_ADMIN_PRINCIPAL_ARN }}
        run: terraform init -reconfigure

      - name: Remove K8s resources and Helm releases
        shell: bash
        run: |
          kubectl delete ingress --all -A --ignore-not-found || true
          kubectl delete svc --all -A --field-selector spec.type=LoadBalancer --ignore-not-found || true
          helm uninstall aws-load-balancer-controller -n kube-system --ignore-not-found || true
          helm uninstall aws-ebs-csi-driver -n kube-system --ignore-not-found || true
          helm uninstall ingress-nginx -n ingress-nginx --ignore-not-found || true
          sleep 60

      - name: Delete EKS node groups
        shell: bash
        run: |
          set -euo pipefail
          CLUSTER_NAME="${{ secrets.VPC_NAME }}-cluster"
          REGION="${{ secrets.AWS_REGION }}"
          if aws eks describe-cluster --name "$CLUSTER_NAME" --region "$REGION" >/dev/null 2>&1; then
            NODEGROUPS=$(aws eks list-nodegroups --cluster-name "$CLUSTER_NAME" --region "$REGION" --query 'nodegroups[]' --output text)
            if [ -n "${NODEGROUPS// /}" ]; then
              for NG in $NODEGROUPS; do
                echo "Deleting node group: $NG"
                aws eks delete-nodegroup --cluster-name "$CLUSTER_NAME" --nodegroup-name "$NG" --region "$REGION" || true
                aws eks wait nodegroup-deleted --cluster-name "$CLUSTER_NAME" --nodegroup-name "$NG" --region "$REGION" || true
              done
            fi
          fi

      - name: Remove Terraform state for manually deleted resources
        working-directory: ./terraform
        shell: bash
        run: |
          terraform state rm aws_eks_node_group.main 2>/dev/null || true
          terraform state rm aws_eks_cluster.main 2>/dev/null || true
          terraform state rm kubernetes_namespace_v1.banking 2>/dev/null || true
          terraform state rm helm_release.ingress_nginx 2>/dev/null || true
          terraform state rm helm_release.ebs_csi_driver 2>/dev/null || true

      - name: Terraform Destroy
        working-directory: ./terraform
        env:
          TF_VAR_eks_admin_principal_arn: ${{ secrets.EKS_ADMIN_PRINCIPAL_ARN }}
        run: terraform destroy -auto-approve