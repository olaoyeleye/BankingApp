# Production environment overrides
environment: prod

# Production: full resources, multiple replicas, TLS
frontend:
  replicas: 3
  resources:
    requests:
      memory: "256Mi"
      cpu: "150m"
    limits:
      memory: "512Mi"
      cpu: "200m"

userService:
  replicas: 3
  resources:
    requests:
      memory: "256Mi"
      cpu: "150m"
    limits:
      memory: "512Mi"
      cpu: "200m"

transactionService:
  replicas: 3
  resources:
    requests:
      memory: "512Mi"
      cpu: "150m"
    limits:
      memory: "1Gi"
      cpu: "300m"

activityService:
  replicas: 3
  resources:
    requests:
      memory: "256Mi"
      cpu: "50m"
    limits:
      memory: "512Mi"
      cpu: "100m"

postgres:
  replicas: 1
  resources:
    requests:
      memory: "512Mi"
      cpu: "500m"
    limits:
      memory: "1Gi"
      cpu: "1000m"
  persistence:
    enabled: true
    storageClassName: gp2
    size: 20Gi

redis:
  replicas: 1
  resources:
    requests:
      memory: "128Mi"
      cpu: "100m"
    limits:
      memory: "256Mi"
      cpu: "200m"

kafka:
  replicas: 1
  resources:
    requests:
      memory: "1Gi"
      cpu: "250m"
    limits:
      memory: "2Gi"
      cpu: "500m"

ingress:
  enabled: true
  className: nginx
  host: "bank.yourdomain.com"
  tls:
    enabled: true
    secretName: banking-prod-tls

secrets:
  postgresDb: bankingdb
  postgresUser: CHANGE_ME
  postgresPassword: CHANGE_ME
  nodeEnv: production

configmap:
  springJpaHibernateDdlAuto: "none"
  frontendOrigin: "https://bank.yourdomain.com"
  bankFrontend: "https://bank.yourdomain.com"

datadog:
  enabled: true
  apiKey: ""
  appKey: ""